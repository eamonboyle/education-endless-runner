/* Math Runner components — chunky casual buttons floating over the 3D city */
.safe-area {
    flex-grow: 1;
    width: 100%;
    height: 100%;
}

.screen {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    padding: var(--space-3);
    background-color: rgba(0, 0, 0, 0);
}

.screen--centered {
    justify-content: center;
    align-items: center;
}

/* Transparent shell so the MainMenu / ModeChoice city stays visible */
.menu-bg {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0);
    align-items: center;
    justify-content: flex-end;
    padding: 18px var(--space-3) 26px;
}

.menu-shell {
    width: 100%;
    max-width: 920px;
    flex-grow: 1;
    justify-content: space-between;
    align-items: stretch;
    padding-top: 28px;
}

.menu-stack {
    width: 100%;
    max-width: 920px;
    align-items: stretch;
}

.brand-block {
    align-items: center;
    margin-bottom: 8px;
}

.logo-eyebrow {
    font-size: 22px;
    color: var(--color-paper-solid);
    letter-spacing: 4px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    text-shadow: 0 2px 0 rgba(10, 22, 40, 0.35);
    margin-bottom: 2px;
}

/* Painted sticker wordmark — lane dashes live inside the art */
.logo-mark {
    width: 660px;
    height: 400px;
    align-self: center;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/Art/UI/math_runner_logo.png");
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: rgb(255, 255, 255);
    margin-bottom: var(--space-1);
}

.logo {
    font-size: var(--font-size-hero);
    -unity-font-definition: var(--font-display);
    -unity-font-style: bold;
    color: var(--color-paper-solid);
    -unity-text-align: middle-center;
    white-space: normal;
    text-shadow: 0 4px 0 rgba(10, 22, 40, 0.4);
    margin-bottom: var(--space-2);
}

/* Fallback CSS lanes (hidden when logo-mark is used) */
.lane-stripes {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    margin-top: var(--space-1);
    margin-bottom: var(--space-3);
}

.lane-dash {
    width: 72px;
    height: 14px;
    border-radius: 8px;
    margin: 0 8px;
    border-width: 0;
}

.lane-dash--left {
    background-color: var(--color-lane-left);
    rotate: -8deg;
}

.lane-dash--center {
    background-color: var(--color-lane);
    height: 16px;
    width: 88px;
}

.lane-dash--right {
    background-color: var(--color-lane-right);
    rotate: 8deg;
}

/*
 * Action stack — Birdie-Queue style: chunky buttons float over the 3D city.
 * No cracked asphalt plate. Optional .panel adds a cream card for text-heavy screens.
 */
.menu-dock {
    background-color: rgba(0, 0, 0, 0);
    background-image: none;
    border-radius: 0;
    padding: 8px 16px 0;
    border-width: 0;
    align-items: stretch;
}

.menu-dock__hint {
    font-size: 28px;
    color: var(--color-paper-solid);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 4px;
    text-shadow: 0 3px 0 rgba(10, 22, 40, 0.45);
}

.menu-dock.panel {
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/Art/UI/dock_panel.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgb(255, 255, 255);
    -unity-slice-left: 80;
    -unity-slice-right: 80;
    -unity-slice-top: 80;
    -unity-slice-bottom: 80;
    border-width: 0;
    border-radius: var(--radius-panel);
    padding: var(--space-4) var(--space-3) var(--space-3);
}

.menu-dock .label {
    color: var(--color-paper-solid);
    text-shadow: 0 2px 0 rgba(10, 22, 40, 0.35);
}

.menu-dock .label--muted {
    color: rgba(255, 252, 247, 0.88);
    text-shadow: 0 2px 0 rgba(10, 22, 40, 0.35);
}

.menu-dock.panel .label {
    color: var(--color-ink);
    text-shadow: 0 0 0 rgba(0, 0, 0, 0);
}

.menu-dock.panel .label--muted {
    color: var(--color-ink-muted);
    text-shadow: 0 0 0 rgba(0, 0, 0, 0);
}

.menu-dock.panel .menu-dock__hint {
    color: var(--color-ink-muted);
    text-shadow: 0 0 0 rgba(0, 0, 0, 0);
}

.menu-dock .chip {
    background-color: rgba(255, 252, 247, 0.92);
    color: var(--color-ink);
    border-width: 4px;
    border-color: rgb(42, 28, 18);
}

.menu-dock .chip.selected {
    background-color: var(--color-lane);
    color: var(--color-ink);
    border-color: rgb(42, 28, 18);
}

.panel {
    background-color: var(--color-paper);
    border-radius: var(--radius-panel);
    padding: var(--space-4);
    border-width: 2px;
    border-color: var(--color-paper-edge);
}

.panel--dark {
    background-color: var(--color-overlay);
    border-color: rgba(255, 255, 255, 0.12);
}

.title {
    font-size: var(--font-size-xl);
    -unity-font-definition: var(--font-display);
    color: var(--color-ink);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: var(--space-2);
}

.title--on-sky {
    color: var(--color-paper-solid);
    text-shadow: 0 3px 0 rgba(10, 22, 40, 0.4);
}

.subtitle {
    font-size: var(--font-size-sm);
    color: var(--color-ink-muted);
    -unity-text-align: middle-center;
    margin-bottom: var(--space-3);
}

.subtitle--on-sky {
    color: rgba(255, 252, 247, 0.9);
    text-shadow: 0 2px 0 rgba(10, 22, 40, 0.35);
}

.label {
    font-size: var(--font-size-sm);
    color: var(--color-ink);
}

.label--muted {
    color: var(--color-ink-muted);
}

.label--hero {
    font-size: var(--font-size-hero);
    -unity-font-definition: var(--font-display);
    -unity-font-style: bold;
    color: var(--color-paper-solid);
    -unity-text-align: middle-center;
    text-shadow: 0 4px 0 rgba(10, 22, 40, 0.45);
}

.btn {
    min-height: 116px;
    min-width: 280px;
    padding: 18px 28px;
    border-radius: 0;
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/Art/UI/btn_primary.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgb(255, 255, 255);
    -unity-slice-left: 64;
    -unity-slice-right: 64;
    -unity-slice-top: 28;
    -unity-slice-bottom: 28;
    color: rgb(255, 249, 221);
    font-size: 40px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    letter-spacing: 2px;
    border-width: 0;
    border-color: rgba(0, 0, 0, 0);
    margin: 6px 0;
    overflow: visible;
    transition-property: scale, opacity;
    transition-duration: var(--motion-fast);
}

/* Beat unity-theme Button defaults so candy skins stick */
Button.btn {
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/Art/UI/btn_primary.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgb(255, 255, 255);
    -unity-slice-left: 64;
    -unity-slice-right: 64;
    -unity-slice-top: 28;
    -unity-slice-bottom: 28;
    border-width: 0;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 0;
}

Button.btn:hover,
Button.btn:active,
Button.btn:focus {
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/Art/UI/btn_primary.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgb(255, 255, 255);
    -unity-slice-left: 64;
    -unity-slice-right: 64;
    -unity-slice-top: 28;
    -unity-slice-bottom: 28;
    border-width: 0;
    outline-width: 0;
}

.btn:hover {
    opacity: 0.94;
}

.btn:active {
    scale: 0.985 0.985;
}

.btn--primary {
    background-image: url("project://database/Assets/Art/UI/btn_primary.png");
    color: var(--color-paper-solid);
    font-size: 54px;
    min-height: 148px;
    margin-bottom: 8px;
    letter-spacing: 3px;
    text-shadow: 0 4px 0 rgb(117, 48, 33);
}

Button.btn--primary,
Button.btn--primary:hover,
Button.btn--primary:active,
Button.btn--primary:focus {
    background-image: url("project://database/Assets/Art/UI/btn_primary.png");
    background-color: rgba(0, 0, 0, 0);
    -unity-background-image-tint-color: rgb(255, 255, 255);
    color: var(--color-paper-solid);
}

.btn--secondary {
    background-image: url("project://database/Assets/Art/UI/btn_primary.png");
    color: rgb(255, 249, 221);
    border-width: 0;
}

Button.btn--secondary,
Button.btn--secondary:hover,
Button.btn--secondary:active,
Button.btn--secondary:focus {
    background-image: url("project://database/Assets/Art/UI/btn_primary.png");
    background-color: rgba(0, 0, 0, 0);
    -unity-background-image-tint-color: rgb(255, 255, 255);
    color: rgb(255, 249, 221);
}

.btn--secondary:hover {
    opacity: 0.94;
}

.btn--ghost {
    background-color: rgba(255, 255, 255, 0.18);
    background-image: none;
    color: var(--color-paper-solid);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.45);
    border-radius: var(--radius-btn);
}

.btn--danger {
    background-color: var(--color-wrong);
    background-image: none;
    color: var(--color-paper-solid);
    border-radius: var(--radius-btn);
    border-bottom-width: 5px;
    border-bottom-color: rgb(196, 48, 56);
}

.btn--block {
    width: 100%;
    align-self: stretch;
}

.btn-row {
    flex-direction: row;
    justify-content: space-between;
    margin: 0;
}

.btn-row > .btn {
    flex-grow: 1;
    min-width: 0;
    margin-left: 6px;
    margin-right: 6px;
}

.card {
    background-color: rgba(255, 252, 247, 0.92);
    border-radius: var(--radius-card);
    padding: var(--space-3);
    margin: var(--space-1) 0;
    border-width: 3px;
    border-color: transparent;
    border-left-width: 10px;
    border-left-color: rgba(16, 37, 63, 0.12);
    min-height: var(--touch-min);
    transition-property: border-color, scale, background-color;
    transition-duration: var(--motion-fast);
}

.card.selected {
    border-color: var(--color-sprint);
    border-left-color: var(--color-lane);
    background-color: rgb(255, 252, 247);
    scale: 1.02 1.02;
}

.card__title {
    font-size: var(--font-size-md);
    -unity-font-style: bold;
    color: var(--color-ink);
}

.card__subtitle {
    font-size: var(--font-size-xs);
    color: var(--color-ink-muted);
    margin-top: var(--space-1);
}

.chip {
    min-height: 72px;
    min-width: 140px;
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-chip);
    background-color: rgba(16, 37, 63, 0.08);
    color: var(--color-ink);
    font-size: var(--font-size-sm);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    border-width: 0;
    margin: var(--space-1);
}

.chip.selected {
    background-color: var(--color-ink);
    color: var(--color-lane);
}

.chip-row {
    flex-direction: row;
    justify-content: center;
    flex-wrap: wrap;
    margin: var(--space-2) 0;
}

.progress-track {
    height: 22px;
    background-color: rgba(16, 37, 63, 0.12);
    border-radius: 12px;
    overflow: hidden;
    margin: var(--space-1) 0;
}

.progress-fill {
    height: 100%;
    width: 0%;
    background-color: var(--color-sprint);
    border-radius: 12px;
    transition-property: width;
    transition-duration: var(--motion-panel);
}

.hud-root {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0);
}

.hud-lives {
    position: absolute;
    left: var(--space-3);
    top: var(--space-3);
    font-size: var(--font-size-lg);
    color: var(--color-heart);
    -unity-font-style: bold;
    text-shadow: 0 3px 0 rgba(0, 0, 0, 0.45);
}

.hud-score {
    position: absolute;
    left: var(--space-3);
    top: 120px;
    font-size: var(--font-size-lg);
    -unity-font-definition: var(--font-display);
    color: var(--color-paper-solid);
    -unity-font-style: bold;
    text-shadow: 0 3px 0 rgba(0, 0, 0, 0.45);
}

.hud-combo {
    position: absolute;
    left: var(--space-3);
    top: 210px;
    font-size: var(--font-size-md);
    color: var(--color-lane);
    -unity-font-style: bold;
    text-shadow: 0 3px 0 rgba(0, 0, 0, 0.45);
}

.hud-speed {
    position: absolute;
    right: var(--space-3);
    bottom: var(--space-3);
    font-size: var(--font-size-sm);
    color: rgba(255, 255, 255, 0.88);
    -unity-font-style: bold;
    text-shadow: 0 2px 0 rgba(0, 0, 0, 0.4);
}

.hud-powerups {
    position: absolute;
    right: var(--space-3);
    top: var(--space-3);
    flex-direction: row;
}

.powerup-slot {
    width: 96px;
    height: 96px;
    margin-left: var(--space-1);
    background-color: rgba(10, 22, 40, 0.55);
    border-radius: 20px;
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.2);
    align-items: center;
    justify-content: center;
    display: none;
}

.powerup-slot.visible {
    display: flex;
}

.powerup-slot__label {
    font-size: var(--font-size-xs);
    color: var(--color-paper-solid);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.powerup-slot.flashing {
    opacity: 0.45;
}

.flash-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0);
    transition-property: background-color;
    transition-duration: var(--motion-fast);
}

.flash-overlay.flash-correct {
    background-color: rgba(61, 220, 151, 0.28);
}

.flash-overlay.flash-wrong {
    background-color: rgba(255, 90, 95, 0.32);
}

.vignette {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    border-width: 0;
    border-color: rgba(0, 0, 0, 0);
    transition-property: border-color, border-width;
    transition-duration: var(--motion-panel);
}

.toast {
    position: absolute;
    left: var(--space-3);
    right: var(--space-3);
    top: 80px;
    background-color: var(--color-paper);
    border-radius: var(--radius-card);
    border-width: 2px;
    border-color: var(--color-paper-edge);
    border-left-width: 10px;
    border-left-color: var(--color-lane);
    padding: var(--space-3);
    opacity: 0;
    translate: 0 -40px;
    transition-property: opacity, translate;
    transition-duration: var(--motion-panel);
}

.toast.visible {
    opacity: 1;
    translate: 0 0;
}

.toast__title {
    font-size: var(--font-size-md);
    -unity-font-style: bold;
    color: var(--color-ink);
}

.toast__body {
    font-size: var(--font-size-sm);
    color: var(--color-ink-muted);
    margin-top: var(--space-1);
}

.celebration {
    position: absolute;
    left: 0;
    right: 0;
    top: 35%;
    font-size: var(--font-size-xl);
    -unity-font-definition: var(--font-display);
    -unity-font-style: bold;
    color: var(--color-lane);
    -unity-text-align: middle-center;
    text-shadow: 0 4px 0 rgba(0, 0, 0, 0.55);
    display: none;
}

.celebration.visible {
    display: flex;
}

.modal-backdrop {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    background-color: var(--color-overlay);
    justify-content: center;
    align-items: center;
    padding: var(--space-4);
}

.modal-card {
    width: 90%;
    max-width: 900px;
    background-color: var(--color-paper);
    border-radius: var(--radius-panel);
    border-width: 2px;
    border-color: var(--color-paper-edge);
    padding: var(--space-4);
    align-items: stretch;
}

.fade-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgb(0, 0, 0);
    opacity: 0;
    transition-property: opacity;
    transition-duration: var(--motion-slow);
}

.fade-overlay.visible {
    opacity: 1;
}

.loading-label {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 18%;
    font-size: var(--font-size-md);
    color: var(--color-paper-solid);
    -unity-text-align: middle-center;
    text-shadow: 0 2px 0 rgba(0, 0, 0, 0.45);
    display: none;
}

.loading-label.visible {
    display: flex;
}

.row {
    flex-direction: row;
    align-items: center;
}

.col {
    flex-direction: column;
}

.spacer {
    flex-grow: 1;
}

.hidden {
    display: none;
}

.question-banner {
    position: absolute;
    left: var(--space-3);
    right: var(--space-3);
    top: 280px;
    background-color: rgba(10, 22, 40, 0.55);
    border-radius: var(--radius-card);
    border-width: 2px;
    border-color: rgba(255, 255, 255, 0.18);
    padding: var(--space-2) var(--space-3);
    align-items: center;
    justify-content: center;
}

.question-banner__text {
    font-size: var(--font-size-lg);
    -unity-font-definition: var(--font-display);
    color: var(--color-paper-solid);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.countdown-label {
    position: absolute;
    left: 0;
    right: 0;
    top: 40%;
    font-size: var(--font-size-hero);
    -unity-font-definition: var(--font-display);
    color: var(--color-lane);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    text-shadow: 0 5px 0 rgba(0, 0, 0, 0.5);
}

.lane-label {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 120px;
    font-size: var(--font-size-sm);
    color: rgba(255, 255, 255, 0.85);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
}

.difficulty-label {
    position: absolute;
    left: var(--space-3);
    bottom: var(--space-3);
    font-size: var(--font-size-xs);
    color: rgba(255, 255, 255, 0.75);
    -unity-font-style: bold;
}

.stats-row {
    flex-direction: row;
    justify-content: space-between;
    margin: var(--space-1) 0;
}

.graph-bar {
    width: 28px;
    background-color: var(--color-sprint);
    border-radius: 8px 8px 0 0;
    margin: 0 4px;
    align-self: flex-end;
}

.graph-row {
    flex-direction: row;
    align-items: flex-end;
    height: 220px;
    justify-content: center;
    margin-top: var(--space-2);
}

.op-grid {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
}

.op-tile {
    width: 48%;
    min-height: 160px;
    margin-bottom: var(--space-2);
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/Art/UI/btn_primary.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgb(255, 255, 255);
    -unity-slice-left: 64;
    -unity-slice-right: 64;
    -unity-slice-top: 28;
    -unity-slice-bottom: 28;
    border-radius: 0;
    border-width: 0;
    color: rgb(255, 249, 221);
    font-size: var(--font-size-sm);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
    align-items: center;
    justify-content: center;
    transition-property: scale, background-color;
    transition-duration: var(--motion-fast);
}

Button.op-tile,
Button.op-tile:hover,
Button.op-tile:active,
Button.op-tile:focus {
    background-color: rgba(0, 0, 0, 0);
    background-image: url("project://database/Assets/Art/UI/btn_primary.png");
    -unity-background-scale-mode: stretch-to-fill;
    -unity-background-image-tint-color: rgb(255, 255, 255);
    -unity-slice-left: 64;
    -unity-slice-right: 64;
    -unity-slice-top: 28;
    -unity-slice-bottom: 28;
    border-width: 0;
}

.op-tile:active {
    scale: 0.97 0.97;
}

.op-tile__symbol {
    font-size: 72px;
    -unity-font-definition: var(--font-display);
    color: var(--color-ink);
    -unity-text-align: middle-center;
    margin-bottom: 4px;
}

.op-tile__name {
    font-size: var(--font-size-sm);
    color: var(--color-ink-soft);
    -unity-text-align: middle-center;
}
